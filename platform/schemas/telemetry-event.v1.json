{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cortex.internal/schemas/telemetry-event.v1.json",
  "title": "TelemetryEvent",
  "description": "Structured event emitted by the platform PostToolUse hook. See SPEC.md",
  "type": "object",
  "required": ["event_id", "invocation_context_id", "plugin_id", "component_id", "level", "phase", "timestamp"],
  "properties": {
    "event_id": {"type": "string"},
    "invocation_context_id": {"type": "string"},
    "plugin_id": {"type": "string"},
    "component_id": {"type": "string"},
    "level": {"enum": ["debug", "info", "warn", "error"]},
    "phase": {"enum": ["start", "progress", "result", "failure"]},
    "capability_interface_id": {"type": ["string", "null"]},
    "bundle_contract_id": {"type": ["string", "null"]},
    "message": {"type": "string"},
    "attributes": {
      "type": "object",
      "properties": {
        "tool_name": {"type": "string"},
        "artifact_id": {"type": "string"},
        "model_id": {"type": "string"},
        "latency_ms": {"type": "integer"},
        "token_cost": {"type": "integer"},
        "tokens_used_total": {"type": "integer"},
        "tokens_ceiling": {"type": "integer"}
      },
      "additionalProperties": true
    },
    "timestamp": {"type": "string", "format": "date-time"},
    "signature": {"type": "string"}
  }
}
