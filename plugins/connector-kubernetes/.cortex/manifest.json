{
  "$schema": "../../../platform/schemas/cortex-plugin-manifest.v1.json",
  "name": "connector-kubernetes",
  "version": "0.1.0",
  "publisher": "internal-devtools",
  "description": "Kubernetes/kubectl MCP connector. No Capability Interfaces; exposes typed tools for pod/deployment/namespace/event ops. Cluster-wide deletes are HITL-gated.",
  "bundle_contracts_touched": [],
  "capability_interfaces_implemented": [],
  "artifacts_authored": [],
  "artifacts_consumed": [],
  "surfaces": {
    "skills": [],
    "subagents": [],
    "slash_commands": [],
    "hooks": []
  },
  "workspace_state_paths_owned": [],
  "connector_dependencies": [],
  "methodology_skills_referenced": [],
  "permissions_required": [
    {"scope": "k8s:read",                "risk_tier": "low",    "approval_policy": "auto"},
    {"scope": "k8s:logs:read",           "risk_tier": "low",    "approval_policy": "auto"},
    {"scope": "k8s:namespace:write",     "risk_tier": "medium", "approval_policy": "checkpoint"},
    {"scope": "k8s:cluster:write",       "risk_tier": "high",   "approval_policy": "checkpoint"}
