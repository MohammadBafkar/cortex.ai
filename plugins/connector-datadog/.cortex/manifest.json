{
  "$schema": "../../../platform/schemas/cortex-plugin-manifest.v1.json",
  "name": "connector-datadog",
  "version": "0.1.0",
  "publisher": "internal-devtools",
  "description": "Connector wrapping Datadog's MCP server. Exposes SLO + metric + dashboard read APIs. Used by release-operate.observe + emit-dora.",
  "bundle_contracts_touched": [],
  "capability_interfaces_implemented": [],
  "artifacts_authored": [],
  "artifacts_consumed": [],
  "surfaces": {
    "skills": [],
    "subagents": [],
    "slash_commands": [],
    "hooks": []
  },
  "workspace_state_paths_owned": [],
  "connector_dependencies": [],
  "methodology_skills_referenced": [],
  "permissions_required": [
    {
      "scope": "datadog:metrics:read",
      "risk_tier": "low",
      "approval_policy": "auto"
    },
    {
      "scope": "datadog:slo:read",
      "risk_tier": "low",
      "approval_policy": "auto"
    },
    {
      "scope": "datadog:dashboards:read",
      "risk_tier": "low",
      "approval_policy": "auto"
    },
    {
      "scope": "datadog:monitors:write",
      "risk_tier": "medium",
      "approval_policy": "hitl"
    }
  ],
  "data_classes_handled": [
    "internal",
    "confidential"
  ],
  "risk_tier": "medium",
  "conformance_suite_ref": ".cortex/conformance.yaml",
  "deprecation_policy": {
    "notice_period_days": 90
  },
  "update_strategy": "patch:auto, minor:auto, major:approval",
  "mcp_servers_always_load": [],
  "packaging_exception": {
    "reason": "Connector plugin \u2014 exposes external MCP tools, no Capability Interfaces. Per CONNECTORS.md.",
    "produces_authoritative_artifacts": false
  }
}
