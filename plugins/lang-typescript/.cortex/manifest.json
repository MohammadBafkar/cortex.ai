{
  "$schema": "../../../platform/schemas/cortex-plugin-manifest.v1.json",
  "name": "lang-typescript",
  "version": "0.1.0",
  "publisher": "internal-devtools",
  "description": "TypeScript language skillset. Specializes generic capability skills (quality.write-unit-test, quality.lint) for TS idioms — vitest, biome, tsc version migration.",
  "bundle_contracts_touched": ["lang-typescript"],
  "capability_interfaces_implemented": [
    {"id": "writeVitestTest",  "version": "1", "schema_in": "PullRequest@v1", "schema_out": "TestSuite@v1"},
    {"id": "lintWithBiome",    "version": "1", "schema_in": "PullRequest@v1", "schema_out": "LintReport@v1"},
    {"id": "migrateTsVersion", "version": "1", "schema_in": "PullRequest@v1", "schema_out": "VersionMigrationProposal@v1"}
  ],
  "artifacts_authored": ["TestSuite", "LintReport", "VersionMigrationProposal"],
  "artifacts_consumed": ["PullRequest", "UserStory"],
  "surfaces": {
    "skills": ["write-vitest-test", "lint-with-biome", "migrate-ts-version"],
    "subagents": ["vitest-author", "biome-linter"],
    "slash_commands": ["/vitest", "/biome", "/ts-migrate"],
    "hooks": []
  },
  "workspace_state_paths_owned": [
    ".agents/state/langs/lang-typescript/<artifact-id>/"
  ],
  "connector_dependencies": [],
  "methodology_skills_referenced": ["methodology.tdd", "methodology.verify", "methodology.read-code", "methodology.risk-assess"],
  "permissions_required": [
    {"scope": "fs:write:tests",   "risk_tier": "low", "approval_policy": "auto"},
    {"scope": "fs:read",          "risk_tier": "low", "approval_policy": "auto"},
    {"scope": "test-runner:exec", "risk_tier": "low", "approval_policy": "auto"}
  ],
  "data_classes_handled": ["internal"],
  "risk_tier": "medium",
  "conformance_suite_ref": ".cortex/conformance.yaml",
  "deprecation_policy": {"notice_period_days": 90},
  "update_strategy": "patch:auto, minor:auto, major:approval",
  "mcp_servers_always_load": []
}
