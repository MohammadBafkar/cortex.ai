{
  "$schema": "../../../platform/schemas/cortex-plugin-manifest.v1.json",
  "name": "connector-github",
  "version": "0.2.0",
  "publisher": "internal-devtools",
  "description": "GitHub MCP connector. Carries no Capability Interfaces; exposes typed tools (issues, PRs, branches, commits, releases) for capability plugins to compose.",
  "bundle_contracts_touched": [],
  "capability_interfaces_implemented": [],
  "artifacts_authored": [],
  "artifacts_consumed": [],
  "surfaces": {
    "skills": [],
    "subagents": [],
    "slash_commands": [],
    "hooks": []
  },
  "workspace_state_paths_owned": [],
  "connector_dependencies": [],
  "methodology_skills_referenced": [],
  "permissions_required": [
    {
      "scope": "github:repo:read",
      "risk_tier": "low",
      "approval_policy": "auto"
    },
    {
      "scope": "github:repo:write",
      "risk_tier": "medium",
      "approval_policy": "auto"
    },
    {
      "scope": "github:org:read",
      "risk_tier": "low",
      "approval_policy": "auto"
    }
  ],
  "data_classes_handled": [
    "internal",
    "confidential"
  ],
  "risk_tier": "medium",
  "conformance_suite_ref": ".cortex/conformance.yaml",
  "deprecation_policy": {
    "notice_period_days": 90
  },
  "update_strategy": "patch:auto, minor:auto, major:approval",
  "mcp_servers_always_load": [],
  "packaging_exception": {
    "reason": "Connector plugin — exposes external MCP tools, no Capability Interfaces. Per CONNECTORS.md.",
    "produces_authoritative_artifacts": false
  }
}
