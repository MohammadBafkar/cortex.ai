{
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Bash:git push.*",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"${CLAUDE_PLUGIN_ROOT}/hooks/scripts/route-to-review.sh\"",
            "timeout": 10
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash:gh pr create.*",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"${CLAUDE_PLUGIN_ROOT}/hooks/scripts/gate-pr-open.sh\"",
            "timeout": 5
          }
        ]
      }
    ]
  }
}
