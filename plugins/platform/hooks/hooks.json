{
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Bash:gh pr create.*",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"${CLAUDE_PLUGIN_ROOT}/hooks/scripts/trigger-pipeline.sh\"",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
