{
  "$schema": "../../../platform/schemas/cortex-plugin-manifest.v1.json",
  "name": "connector-terraform",
  "version": "0.1.0",
  "publisher": "internal-devtools",
  "description": "HashiCorp Terraform MCP connector. No Capability Interfaces; exposes typed tools for plan, apply, state, workspace, and registry. terraform:apply scoped writes are HITL-checkpointed.",
  "bundle_contracts_touched": [],
  "capability_interfaces_implemented": [],
  "artifacts_authored": [],
  "artifacts_consumed": [],
  "surfaces": {
    "skills": [],
    "subagents": [],
    "slash_commands": [],
    "hooks": []
  },
  "workspace_state_paths_owned": [],
  "connector_dependencies": [],
  "methodology_skills_referenced": [],
  "permissions_required": [
    {"scope": "terraform:registry:read",   "risk_tier": "low",    "approval_policy": "auto"},
    {"scope": "terraform:state:read",      "risk_tier": "low",    "approval_policy": "auto"},
    {"scope": "terraform:workspace:read",  "risk_tier": "low",    "approval_policy": "auto"},
    {"scope": "terraform:plan",            "risk_tier": "medium", "approval_policy": "auto"},
    {"scope": "terraform:apply:nonprod",   "risk_tier": "medium", "approval_policy": "checkpoint"},
    {"scope": "terraform:apply:prod",      "risk_tier": "high",   "approval_policy": "checkpoint"}
  ],
  "data_classes_handled": ["internal", "confidential"],
  "risk_tier": "high",
  "conformance_suite_ref": ".cortex/conformance.yaml",
  "deprecation_policy": {"notice_period_days": 90},
  "update_strategy": "patch:auto, minor:approval, major:approval",
  "mcp_servers_always_load": [],
  "packaging_exception": {
    "reason": "Connector plugin — exposes external MCP tools, no Capability Interfaces. Per CONNECTORS.md.",
    "produces_authoritative_artifacts": false
  }
}
