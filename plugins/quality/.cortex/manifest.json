{
  "$schema": "../../../platform/schemas/cortex-plugin-manifest.v1.json",
  "name": "quality",
  "version": "0.2.0",
  "publisher": "internal-devtools",
  "description": "Cortex V1 quality plugin for unit-test authoring and test-coverage review.",
  "bundle_contracts_touched": [
    "test-authoring",
    "code-review"
  ],
  "capability_interfaces_implemented": [
    {
      "id": "writeUnitTest",
      "version": "1",
      "schema_in": "PullRequest@v1",
      "schema_out": "TestSuite@v1"
    },
    {
      "id": "reviewTestCoverage",
      "version": "1",
      "schema_in": "PullRequest@v1",
      "schema_out": "ReviewVerdict@v1"
    }
  ],
  "artifacts_authored": [
    "TestSuite",
    "ReviewVerdict"
  ],
  "artifacts_consumed": [
    "PullRequest",
    "TestRun"
  ],
  "surfaces": {
    "skills": [
      "write-unit-test",
      "review-test-coverage"
    ],
    "subagents": [
      "test-author",
      "test-coverage-reviewer"
    ],
    "slash_commands": [
      "/test"
    ],
    "hooks": []
  },
  "workspace_state_paths_owned": [
    ".agents/state/tests/<id>/quality/",
    ".agents/state/reviews/<pr-id>/quality/"
  ],
  "connector_dependencies": [],
  "methodology_skills_referenced": [
    "methodology.tdd",
    "methodology.verify",
    "methodology.risk-assess",
    "methodology.read-code"
  ],
  "permissions_required": [
    {
      "scope": "fs:write:tests",
      "risk_tier": "low",
      "approval_policy": "auto"
    },
    {
      "scope": "fs:read",
      "risk_tier": "low",
      "approval_policy": "auto"
    },
    {
      "scope": "test-runner:exec",
      "risk_tier": "low",
      "approval_policy": "auto"
    },
    {
      "scope": "perf:load-gen",
      "risk_tier": "medium",
      "approval_policy": "auto"
    }
  ],
  "data_classes_handled": [
    "internal",
    "confidential"
  ],
  "risk_tier": "medium",
  "conformance_suite_ref": ".cortex/conformance.yaml",
  "deprecation_policy": {
    "notice_period_days": 90
  },
  "update_strategy": "patch:auto, minor:auto, major:approval",
  "mcp_servers_always_load": []
}
